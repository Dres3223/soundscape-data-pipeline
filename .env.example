# Copy this file to .env and replace the placeholder secrets:
#   cp .env.example .env
# .env is git-ignored: never commit real credentials.

# PostgreSQL: metadata and audio features
POSTGRES_USER=soundscape
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soundscape
POSTGRES_PORT=5432

# S3-compatible object storage (RustFS): raw audio files
S3_ACCESS_KEY=soundscape-admin
S3_SECRET_KEY=change-me-too
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# Optional: these have defaults in src/soundscape/config.py
# POSTGRES_HOST=localhost
# S3_ENDPOINT_URL=http://localhost:9000   # leave empty to use AWS S3
# S3_BUCKET=soundscape
# S3_REGION=us-east-1
# INGEST_SOURCE_DIR=data/raw/birdclef/train_soundscapes
# INGEST_SOURCE_NAME=birdclef-2025
# FEATURES_SAMPLE_RATE=32000
# FEATURES_N_MFCC=20

# Apache Airflow (http://localhost:8080, user: admin)
# Generate each secret with: python3 -c "import secrets; print(secrets.token_hex(24))"
AIRFLOW_ADMIN_PASSWORD=change-me-admin
AIRFLOW_DB_PASSWORD=change-me-airflow-db
AIRFLOW_JWT_SECRET=change-me-jwt
# Fernet key (must be 32 url-safe base64 bytes), generate with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# AIRFLOW_PORT=8080

# Dashboard (http://localhost:8501): read-only Postgres role for the marts
DASHBOARD_DB_PASSWORD=change-me-dashboard
# DASHBOARD_PORT=8501

# AWS emulator (make emulator); its credentials are written to .env.moto
# MOTO_PORT=5001
